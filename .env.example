# Environment Variables Template - Miss Roses Exquisite
# Copy this file to .env and replace placeholder values with your real configuration.
# DO NOT commit real secrets or .env files to Git or source control!

# ==============================================================================
# 1. APPLICATION & SERVER SETTINGS
# ==============================================================================
NODE_ENV=development
PORT=3000
APP_NAME="Miss Roses Exquisite"
APP_URL=http://localhost:3000

# ==============================================================================
# 2. SECURITY & AUTHENTICATION
# ==============================================================================
# Secret key for JWT session tokens and cookie signing
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters
SESSION_SECRET=replace_with_another_secure_random_session_secret

# Default Super Admin Initial Setup Credentials (Change immediately upon setup)
SUPER_ADMIN_EMAIL=admin@missrosesexquisite.com
SUPER_ADMIN_INITIAL_PASSWORD=ChangeMeOnFirstLogin123!

# ==============================================================================
# 3. DATABASE CONFIGURATION
# ==============================================================================
# Database driver: sqlite, postgres, or mysql
DB_TYPE=sqlite
DB_STORAGE=../database/miss_roses_exquisite.sqlite

# If using PostgreSQL / MySQL in production:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=miss_roses_exquisite
# DB_USER=missroses_user
# DB_PASSWORD=your_secure_db_password

# ==============================================================================
# 4. EMAIL NOTIFICATION SETTINGS (SMTP or API)
# ==============================================================================
# Local testing can use ethereal/mailtrap; production uses SendGrid/Resend/AWS SES
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Miss Roses Exquisite <orders@missrosesexquisite.com>"
ADMIN_NOTIFICATION_EMAIL=admin@missrosesexquisite.com

# ==============================================================================
# 5. SMS NOTIFICATION SETTINGS (Twilio / Hubtel / Arkesel)
# ==============================================================================
SMS_PROVIDER=arkesel
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=MissRoses
# If using Twilio:
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# 6. FILE STORAGE & UPLOADS
# ==============================================================================
UPLOAD_DIR=../product-images/
MAX_FILE_SIZE_MB=5
